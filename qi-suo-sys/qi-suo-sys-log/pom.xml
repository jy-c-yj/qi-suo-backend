<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.cyj</groupId>
        <artifactId>qi-suo-sys</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>qi-suo-sys-log</artifactId>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- com.cyj.common.TraceConstants：链路 id 的头名 / MDC 键，与网关、common-feign 共用 -->
        <dependency>
            <groupId>com.cyj</groupId>
            <artifactId>qi-suo-common-core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
          只为编译 TraceIdMdcFilter 用的 OncePerRequestFilter / jakarta.servlet。
          optional=true 是关键：不向下传递，否则网关（WebFlux）会被带上 spring-webmvc 而启动失败。
          各业务服务自己已声明 spring-boot-starter-web，运行时并不缺。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.cyj</groupId>
            <artifactId>qi-suo-common-rabbitMQ</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <!--
          SysOperLogMapper 用到的 BaseMapper / @Insert / <script>，只为编译。
          各服务已通过自己的 qi-suo-common-mybatis 依赖带上 mybatis-plus，
          这里的 optional=true 表示不向下传递，不改变任何服务的运行时依赖图。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>